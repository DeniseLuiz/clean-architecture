{
  "name": "referencial",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "api",

  "workspaceFolder": "/src",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.analysis.extraPaths": [
          "/src"
        ],
        "python.analysis.typeCheckingMode": "basic"
      }
    }
  }
}